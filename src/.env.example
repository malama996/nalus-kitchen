# Public Supabase client configuration. Safe to expose in browser when RLS is correctly configured.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Server/CLI only. NEVER expose these as VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-jwt

# Optional local bootstrap values
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Flutterwave server-only secrets. NEVER prefix these with VITE_ or expose them in the browser.
FLW_SECRET_KEY=FLWSECK_xxxxxxxx
FLW_WEBHOOK_SECRET_HASH=replace-with-a-long-random-webhook-secret
