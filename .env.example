# Copy to .env and fill in real values. Never commit .env.

# --- Build-time (baked into the client bundle; set in Netlify > Site settings > Environment variables) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Runtime: server functions (same Netlify env vars; read via process.env) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime: Flutterwave payments ---
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=

# --- Local-only: used by `npm run bootstrap:admin` to create the admin account ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
